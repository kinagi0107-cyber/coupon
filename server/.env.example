# データベース接続URL（Render PostgreSQL の Internal Database URL を使用）
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 管理者ユーザー名
ADMIN_USERNAME=admin

# 管理者パスワード（本番環境では必ず変更してください）
ADMIN_PASSWORD=nanaehama2611

# JWT署名シークレット（ランダムな長い文字列を設定してください）
# 例: openssl rand -base64 64 で生成
JWT_SECRET=your-very-long-random-secret-string-here

# サーバーポート（Renderでは自動設定されるため通常は不要）
PORT=3001

# フロントエンドのURL（CORS設定に使用）
CLIENT_URL=http://localhost:5173
